{
  "name": "opensourcebook",
  "version": "0.1.1",
  "description": "Installs Open Sourcebook on this computer and starts it: an open-source app that helps you understand and explain what you have to read, with cited answers, quizzes, audio and short videos made from your own sources.",
  "keywords": [
    "study",
    "notes",
    "flashcards",
    "quiz",
    "explainer-video",
    "citations",
    "claude-code",
    "codex",
    "open-source",
    "installer"
  ],
  "license": "MIT",
  "type": "module",
  "homepage": "https://opensourcebook.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mikiyas-Meles-Assefa/opensourcebook.git",
    "directory": "install/package"
  },
  "bugs": "https://github.com/Mikiyas-Meles-Assefa/opensourcebook/issues",
  "bin": {
    "opensourcebook": "bin/opensourcebook.mjs"
  },
  "files": [
    "bin",
    "lib",
    "source.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=24"
  }
}
