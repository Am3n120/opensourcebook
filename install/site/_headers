# Headers for the files in this folder, in the plain "path, then indented headers" form
# that static hosts read from a file named _headers at the site root.

# The two install scripts are read by curl and PowerShell, and by people in a browser.
# They must arrive as plain text, never as a download or a web page, and a fix to one
# must reach everyone within minutes.
/install
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300, must-revalidate

/install.ps1
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300, must-revalidate

# The summary for agents, read as plain text.
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300, must-revalidate

# The page: always checked for a newer copy before it is shown.
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

# The source of og.png is kept beside it and is not a page to find in a search.
/og-image*
  X-Robots-Tag: noindex

# The app screens and video clips on the page: kept a day, then checked again.
/media/*
  Cache-Control: public, max-age=86400

# Everything: the page loads nothing from anywhere else, only its own files, and this holds it to that.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; img-src 'self' data:; media-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
