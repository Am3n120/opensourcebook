# Copy to .env (git-ignored) in this folder; `npm start` reads it. README lists every setting.
OPENSOURCEBOOK_CONNECTOR_TOKEN=
# Optional: the scenes service's narrower token, and its own folders (":"-separated) where its turns may work.
OPENSOURCEBOOK_CONNECTOR_SCENES_TOKEN=
OPENSOURCEBOOK_CONNECTOR_SCENES_ROOTS=
# Optional API keys of your own, billed as API use: for an agent that is not signed in, and for its boxed workspaces.
# Never a subscription token: each agent uses its own login as you signed it in.
OPENSOURCEBOOK_ANTHROPIC_API_KEY=
OPENSOURCEBOOK_OPENAI_API_KEY=
# A Gemini API key: only for Antigravity in the box, where the connector adds it to the model calls it forwards.
OPENSOURCEBOOK_GEMINI_API_KEY=
