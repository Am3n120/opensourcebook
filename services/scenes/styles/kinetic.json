  },
  "art": {
    "scene": "Bold graphic poster illustration on a near-black background: flat off-white and red-orange shapes, no texture, the subject simple and instantly recognizable.",
    "object": "Bold flat graphic of a single object shown whole on a plain near-black background: off-white shapes, one red-orange accent, nothing around it.",
    "diagram": "Bold graphic diagram on a near-black background: thick off-white lines, one red-orange accent, simple clear shapes, one idea only."
