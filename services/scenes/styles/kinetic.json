  "design": {
    "moves": {
      "leans": [
        {
          "move": "pop",
          "why": "in kinetic type each word lands on the beat it is spoken, so a quick pop keeps the words in time with the voice"
        },
        {
          "move": "slam",
          "why": "a key word that drops in large and lands gives the line its stress"
        },
        {
          "move": "cut",
          "why": "hard cuts between lines keep the rhythm of the speech instead of easing it away"
        }
      ]
    },
