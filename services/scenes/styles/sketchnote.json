    "body": "Patrick Hand"
  },
  "art": {
    "scene": "Hand-drawn sketchnote illustration: confident black felt-pen lines on a cream notebook page, a little blue and yellow highlighter, the subject simple and instantly recognizable.",
    "object": "Sketchnote doodle of a single object shown whole on a plain cream notebook page: black felt-pen outline, a touch of blue, nothing around it.",
    "diagram": "Simple sketchnote diagram on a cream notebook page: black felt-pen lines, one blue accent, yellow highlighter, simple clear shapes, one idea only."
  },
