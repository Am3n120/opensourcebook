  "design": {
    "moves": {
      "leans": [
        {
          "move": "draw",
          "why": "a sketchnote grows stroke by stroke, so lines and words drawn on as they are said feel like the pen at work"
        },
        {
          "move": "pop",
          "why": "a doodle added in the margin lands quickly, the way a person adds a small drawing beside a note"
        },
        {
          "move": "wipe",
          "why": "turning to a fresh page between ideas keeps each page about one thing"
        }
      ]
    },
